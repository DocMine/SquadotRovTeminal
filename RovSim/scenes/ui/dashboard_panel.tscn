[gd_scene format=3]

[ext_resource type="Script" path="res://RovSim/scripts/ui/dashboard.gd" id="1"]

[node name="Dashboard" type="PanelContainer"]
anchors_preset = 15
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="Root" type="VBoxContainer" parent="Margin"]

[node name="Title" type="Label" parent="Margin/Root"]
text = "Dashboard"

[node name="Depth" type="Label" parent="Margin/Root"]
text = "Depth: -"

[node name="Velocity" type="Label" parent="Margin/Root"]
text = "Velocity: -"

[node name="RPY" type="Label" parent="Margin/Root"]
text = "Roll: -  Pitch: -  Yaw: -"

[node name="Thrusters" type="RichTextLabel" parent="Margin/Root"]
custom_minimum_size = Vector2(0, 240)
fit_content = true
