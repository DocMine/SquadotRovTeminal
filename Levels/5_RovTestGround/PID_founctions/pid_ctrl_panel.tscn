[sub_resource type="GDScript" id="GDScript_3oun4"]
script/source = "extends Panel
# 这个UI组件专门用于调试PID组件
# 只需要将它链接到指定的PIDController对象，就可以完成实时控制功能

@export_group(\"Title Text\")
@export var Title:String = \"大标题\"

# 内部的引用
@export_category(\"引用\")
@export_group(\"P Nodes\")
@export var P_MinNode:TextEdit
@export var P_MaxNode:TextEdit
@export var P_SlideNode:HSlider
@export_group(\"I Nodes\")
@export var I_MinNode:TextEdit
@export var I_MaxNode:TextEdit
@export var I_SlideNode:HSlider
@export_group(\"D Nodes\")
@export var D_MinNode:TextEdit
@export var D_MaxNode:TextEdit
@export var D_SlideNode:HSlider

@export_group(\"Title Label Nodes\")
@export var MainTitle:Label
@export var PTitle:Label
@export var ITitle:Label
@export var DTitle:Label

@export var P_value_label:Label
@export var I_value_label:Label
@export var D_value_label:Label


var pid_controller:PIDController

func _ready() -> void:
	# 更新text
	MainTitle.text = Title
	# 所有的变化都会触发更新
	await get_tree().create_timer(0.2).timeout
	if pid_controller:
		P_SlideNode.value = pid_controller.P
		I_SlideNode.value = pid_controller.I
		D_SlideNode.value = pid_controller.D
	
	P_SlideNode.value_changed.connect(_value_changed)
	I_SlideNode.value_changed.connect(_value_changed)
	D_SlideNode.value_changed.connect(_value_changed)
	P_MinNode.text_changed.connect(_value_changed)
	P_MaxNode.text_changed.connect(_value_changed)
	I_MinNode.text_changed.connect(_value_changed)
	I_MaxNode.text_changed.connect(_value_changed)
	D_MinNode.text_changed.connect(_value_changed)
	D_MaxNode.text_changed.connect(_value_changed)
	
func _physics_process(_delta: float) -> void:
	_updateShow()

func _updateShow():
	# 更新UI显示, 无论如何数值显示都是控制器实际值
	if pid_controller:
		P_value_label.text = \"%.4f\" % pid_controller.P
		I_value_label.text = \"%.4f\" % pid_controller.I
		D_value_label.text = \"%.4f\" % pid_controller.D
	
func _value_changed(_V):
	# 更新极值
	P_SlideNode.min_value = float(P_MinNode.text)
	P_SlideNode.max_value = float(P_MaxNode.text)
	I_SlideNode.min_value = float(I_MinNode.text)
	I_SlideNode.max_value = float(I_MaxNode.text)
	D_SlideNode.min_value = float(D_MinNode.text)
	D_SlideNode.max_value = float(D_MaxNode.text)
	# 更新步长
	P_SlideNode.step = (P_SlideNode.max_value - P_SlideNode.min_value) / 200
	I_SlideNode.step = (I_SlideNode.max_value - I_SlideNode.min_value) / 200
	D_SlideNode.step = (D_SlideNode.max_value - D_SlideNode.min_value) / 200
	
	# 更新数值
	P_value_label.text = \"%.4f\" % P_SlideNode.value
	I_value_label.text = \"%.4f\" % I_SlideNode.value
	D_value_label.text = \"%.4f\" % D_SlideNode.value
	
	if pid_controller:
		# 给指定的控制器赋值, 同时确保滑块在合适位置
		var pp = float(P_SlideNode.value)
		var ii = float(I_SlideNode.value)
		var dd = float(D_SlideNode.value)
		pid_controller.set_pid(pp, ii, dd)
		
"

