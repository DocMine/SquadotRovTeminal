[sub_resource type="GDScript" id="GDScript_c6ser"]
script/source = "extends Node
\"\"\"
ROV 手动控制节点（8 推进器版本）

推进器布局：
【上层垂直推进器】（负责升沉 / 横滚 / 俯仰）
- V_LF : 左前
- V_LB : 左后
- V_RF : 右前
- V_RB : 右后

【下层水平推进器】（负责前进 / 偏航 / 横移）
- H_LF : 左前
- H_LB : 左后
- H_RF : 右前
- H_RB : 右后

使用方式：
1. 在 Project Settings → Input Map 中配置 Action
2. 可在 Inspector 中修改 action_map
3. 支持键盘 / 手柄（摇杆）统一控制
\"\"\"

# =========================================================
# 推进器节点引用
# =========================================================
@onready var ThrusterList:Dictionary = {
	\"V_LF\": null, \"V_LB\": null, \"V_RF\": null, \"V_RB\": null,
	\"H_LF\": null, \"H_LB\": null, \"H_RF\": null, \"H_RB\": null
}

@export var V_LF_thruster:Node3D
@export var V_LB_thruster:Node3D
@export var V_RF_thruster:Node3D
@export var V_RB_thruster:Node3D

@export var H_LF_thruster:Node3D
@export var H_LB_thruster:Node3D
@export var H_RF_thruster:Node3D
@export var H_RB_thruster:Node3D

# 真实参与物理的刚体
@export var RovBaseNode:RigidBody3D

# =========================================================
# 推力与灵敏度参数
# =========================================================
const MAX_THRUST:float = 1000.0   # 单推进器最大推力

@export var heave_gain  :float = 400.0   # 升沉
@export var pitch_gain  :float = 300.0   # 俯仰
@export var roll_gain   :float = 300.0   # 横滚
@export var yaw_gain    :float = 300.0   # 偏航
@export var surge_gain  :float = 400.0   # 前进 / 后退
@export var sway_gain   :float = 300.0   # 横移

# =========================================================
# 输入 Action 映射表
# =========================================================
@export var action_map:Dictionary = {
	\"heave_pos\": \"heave_up\",
	\"heave_neg\": \"heave_down\",

	\"pitch_pos\": \"pitch_up\",
	\"pitch_neg\": \"pitch_down\",

	\"roll_pos\":  \"roll_right\",
	\"roll_neg\":  \"roll_left\",

	\"yaw_pos\":   \"yaw_right\",
	\"yaw_neg\":   \"yaw_left\",

	\"surge_pos\": \"move_forward\",
	\"surge_neg\": \"move_backward\",

	\"sway_pos\":  \"move_right\",
	\"sway_neg\":  \"move_left\"
}

# =========================================================
# 初始化
# =========================================================
func _ready() -> void:
	ThrusterList[\"V_LF\"] = V_LF_thruster
	ThrusterList[\"V_LB\"] = V_LB_thruster
	ThrusterList[\"V_RF\"] = V_RF_thruster
	ThrusterList[\"V_RB\"] = V_RB_thruster

	ThrusterList[\"H_LF\"] = H_LF_thruster
	ThrusterList[\"H_LB\"] = H_LB_thruster
	ThrusterList[\"H_RF\"] = H_RF_thruster
	ThrusterList[\"H_RB\"] = H_RB_thruster

# =========================================================
# 主物理循环
# =========================================================
func _physics_process(delta: float) -> void:
	manual_control(delta)

# =========================================================
# Action 轴读取工具
# =========================================================
func get_axis(pos_key:String, neg_key:String) -> float:
	\"\"\"
	将两个 Action 合成为一个逻辑轴
	返回范围：-1.0 ~ +1.0
	\"\"\"
	var pos_action:String = action_map[pos_key]
	var neg_action:String = action_map[neg_key]
	return Input.get_action_strength(pos_action) - Input.get_action_strength(neg_action)

# =========================================================
# 手动控制核心
# =========================================================
func manual_control(_delta: float) -> void:
	# ---- 读取输入轴 ----
	var heave  :float = get_axis(\"heave_pos\", \"heave_neg\")
	var pitch  :float = get_axis(\"pitch_pos\", \"pitch_neg\")
	var roll   :float = get_axis(\"roll_pos\", \"roll_neg\")
	var yaw    :float = get_axis(\"yaw_pos\", \"yaw_neg\")
	var surge  :float = get_axis(\"surge_pos\", \"surge_neg\")
	var sway   :float = get_axis(\"sway_pos\", \"sway_neg\")

	# ---- 输入 → 推力 ----
	apply_thrust_manual(
		heave * heave_gain,
		pitch * pitch_gain,
		roll  * roll_gain,
		yaw   * yaw_gain,
		surge * surge_gain,
		sway  * sway_gain
	)

# =========================================================
# 推进器混控（Mixer）
# =========================================================
func apply_thrust_manual(
	heave:float,
	pitch:float,
	roll:float,
	yaw:float,
	surge:float,
	sway:float
) -> void:
	\"\"\"
	八推进器混控逻辑

	上层垂直推进器：
	- heave → 全部同向
	- pitch → 前后差动
	- roll  → 左右差动

	下层水平推进器：
	- surge → 前后差动
	- yaw   → 左右差动
	- sway  → 横移
	\"\"\"

	# -------- 上层垂直推进器 --------
	var V_LF:float = heave - pitch + roll
	var V_LB:float = heave + pitch + roll
	var V_RF:float = heave - pitch - roll
	var V_RB:float = heave + pitch - roll

	# -------- 下层水平推进器 --------
	var H_LF:float = surge + yaw
	var H_LB:float = surge + yaw
	var H_RF:float = surge - yaw
	var H_RB:float = surge - yaw

	# 设置推进器输出
	set_thruster_power(\"V_LF\", V_LF)
	set_thruster_power(\"V_LB\", V_LB)
	set_thruster_power(\"V_RF\", V_RF)
	set_thruster_power(\"V_RB\", V_RB)
	set_thruster_power(\"H_LF\", H_LF)
	set_thruster_power(\"H_LB\", H_LB)
	set_thruster_power(\"H_RF\", H_RF)
	set_thruster_power(\"H_RB\", H_RB)

# =========================================================
# 推进器输出
# =========================================================
func set_thruster_power(name:String, power:float) -> void:
	power = clamp(power, -MAX_THRUST, MAX_THRUST) / MAX_THRUST
	ThrusterList[name].set_commd(power)

# =========================================================
# 状态接口
# =========================================================
func get_RovState() -> Dictionary:
	return {
		\"rotation\": RovBaseNode.rotation_degrees,
		\"basis\": RovBaseNode.transform.basis.get_rotation_quaternion(),
		\"global_basis\": RovBaseNode.global_transform.basis.get_rotation_quaternion(),
		\"depth\": RovBaseNode.global_position.y,
		\"state\": \"MANUAL\",
		\"velocity\": RovBaseNode.linear_velocity
	}
"

[sub_resource type="GDScript" id="GDScript_cig8n"]
script/source = "extends Control
# 飞控相关的UI集合，显示基础的姿态和PID调节

@export_group(\"UI nods\")
@export var FCnode:Node
@export var rov_state:ROVState

@export var pitch_ctrl_node:Control
@export var roll_ctrl_node:Control
@export var yaw_ctrl_node:Control

@export var StateNode:Control

func _ready() -> void:
	# 将PID控件绑定到相应的PID控制器
	#pitch_ctrl_node.pid_controller = FCnode.pid_pitch
	#roll_ctrl_node.pid_controller = FCnode.pid_roll
	#yaw_ctrl_node.pid_controller = FCnode.pid_yaw
	
	# 将rovstate节点绑定到相应UI
	StateNode.rov_state = rov_state
"

