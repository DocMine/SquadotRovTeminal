[sub_resource type="GDScript" id="GDScript_lnoqx"]
script/source = "extends Node
## 水动力统一计算节点（纯逻辑组件）
## 负责：推进器力、水阻力、浮力、角阻尼

# =========================================================
# 阻力参数（与外形强相关）
# =========================================================
@export_group(\"水阻力参数\")
## 前后方向阻力系数（ROV 纵向）
@export var drag_forward: float = 4.0
## 横向阻力系数（侧移）
@export var drag_side: float = 10.0
## 垂向阻力系数（升沉）
@export var drag_up: float = 12.0
## 角速度阻尼系数（抑制摇晃的关键）
@export var angular_drag_coeff: float = 4.0


# =========================================================
# 浮力参数
# =========================================================
@export_group(\"浮力参数\")
## 机器人排水体积（m³）
@export var volume: float = 0.00
## 水密度（kg/m³），淡水≈1000，海水≈1025
@export var water_density: float = 1000.0
## 浮心相对质心的偏移（本地坐标）
## 上移可以产生“自动立正”的效果
@export var buoyancy_offset: Vector3 = Vector3(0.1, 0.05, 0)

# =========================================================
# 依赖节点
# =========================================================
@export_group(\"绑定对象\")
## 受力的刚体（必须指定）
@export var body: RigidBody3D
@onready var thrustersNode:Node3D = body.find_child(\"Thrusters\")
@onready var thrusters:Array = []

# --- 用于调试显示的力缓存 ---
var _debug_forces: Array = []
# =========================================================
# 主物理更新
# =========================================================

func _ready() -> void:
	volume = body.mass / water_density
	thrusters = thrustersNode.find_children(\"*\", \"Node3D\", true)

func _physics_process(delta: float) -> void:
	_debug_forces.clear()
	# --- 推进器也在这里应用 ---
	for t in thrusters:
		if not t.has_method(\"get_force\"):
			continue
		t.update_thruster(delta)
		var force: Vector3 = t.get_force()
		var offset: Vector3 = t.global_position - body.global_position
		body.apply_force(force, offset)
		_debug_forces.append({ 
			\"type\": \"thruster\" , # \"thruster\" / \"drag\" / \"buoyancy\"
			\"pos\": t.global_position, 
			\"force\": force })
	# --- 水阻 ---
	apply_anisotropic_drag()
	# --- 角阻尼 ---
	apply_angular_drag()
	# --- 浮力 ---
	apply_buoyancy()

# =========================================================
# 各类力的实现
# =========================================================

## 浮力（作用在浮心位置）
# apply_force 作用位置应当是全局坐标
func apply_buoyancy() -> void:
	var buoyancy_force:Vector3 = Vector3.UP * water_density * volume * 9.81
	var buoyancy_world_pos := body.global_transform.origin + body.global_transform.basis * buoyancy_offset
	body.apply_force(buoyancy_force, buoyancy_world_pos - body.global_transform.origin)
	_debug_forces.append({
		\"type\": \"buoyancy\" , # \"thruster\" / \"drag\" / \"buoyancy\"
		\"pos\": body.global_position + body.global_transform.basis * buoyancy_offset,
		\"force\": buoyancy_force
	})

## 各向异性水阻（与速度平方成正比）
func apply_anisotropic_drag() -> void:
	var v := body.linear_velocity
	if v.length() < 0.001:
		return
	var v_local := body.global_transform.basis.inverse() * v
	
	var drag_local := Vector3(
		-v_local.x * abs(v_local.x) * drag_side,
		-v_local.y * abs(v_local.y) * drag_up,
		-v_local.z * abs(v_local.z) * drag_forward
	)
	
	var drag_world := body.global_transform.basis * drag_local
	body.apply_central_force(drag_world)

	_debug_forces.append({
		\"type\": \"drag\" , # \"thruster\" / \"drag\" / \"buoyancy\"
		\"pos\": body.global_position,
		\"force\": drag_world
	})

## 角速度阻尼（抑制摇摆）
func apply_angular_drag() -> void:
	var w := body.angular_velocity
	if w.length() < 0.001:
		return
	var torque := -w * w.length() * angular_drag_coeff
	body.apply_torque(torque)
	
func get_debug_forces() -> Array:
	return _debug_forces
"

[sub_resource type="GDScript" id="GDScript_pt4hb"]
script/source = "extends Node3D
## 3D 力矢量调试绘制节点（Godot 4.6）
## 使用“细长三角面”模拟粗线条

# =========================================================
# 调试参数
# =========================================================

@export_group(\"调试显示\")

## 是否显示力矢量
@export var debug_draw_forces: bool = true
## 力矢量长度缩放
@export var force_scale: float = 0.5
## 线条视觉粗细（世界单位，建议 0.01 ~ 0.05）
@export var line_thickness: float = 0.15


# =========================================================
# 颜色配置
# =========================================================

@export_group(\"颜色区分\")
## 推进器力颜色
@export var color_thruster: Color = Color.RED
## 浮力颜色
@export var color_buoyancy: Color = Color.GREEN
## 阻力颜色
@export var color_drag: Color = Color.CYAN
## 其他未知力颜色
@export var color_other: Color = Color.GRAY

# =========================================================
# 内部对象
# =========================================================

var _mesh := ImmediateMesh.new()
var _mesh_instance := MeshInstance3D.new()
var _material := StandardMaterial3D.new()

@onready var hydro := get_parent()


func _ready() -> void:
	# --- 材质设置（关键） ---
	_material.vertex_color_use_as_albedo = true
	_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	_material.transparency = BaseMaterial3D.TRANSPARENCY_DISABLED

	_mesh_instance.mesh = _mesh
	_mesh_instance.material_override = _material
	_mesh_instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF

	add_child(_mesh_instance)


func _process(_delta: float) -> void:
	if not debug_draw_forces:
		_mesh.clear_surfaces()
		return

	if hydro.has_method(\"get_debug_forces\"):
		draw_forces(hydro.get_debug_forces())

# =========================================================
# 绘制主逻辑
# =========================================================

func draw_forces(forces: Array) -> void:
	_mesh.clear_surfaces()
	if forces.is_empty():
		return

	for item in forces:
		if not item.has(\"pos\") or not item.has(\"force\"):
			continue
		var world_pos: Vector3 = item.pos
		var force: Vector3 = item.force * force_scale
		if force.length() < 0.0001:
			continue
		var color := get_color_by_type(item.get(\"type\", \"\"))
		
		draw_thick_line(
			to_local(world_pos),
			to_local(world_pos + force),
			line_thickness,
			color
		)


# =========================================================
# 工具函数
# =========================================================

## 根据力类型返回颜色
func get_color_by_type(t: String) -> Color:
	match t:
		\"thruster\":
			return color_thruster
		\"buoyancy\":
			return color_buoyancy
		\"drag\":
			return color_drag
		_:
			return color_other


## 画一条“有厚度的 3D 线段”
func draw_thick_line(p0: Vector3, p1: Vector3, thickness: float, color: Color) -> void:
	var dir:Vector3 = (p1 - p0)
	var Forcelength:float = dir.length()
	if Forcelength < 0.0001:
		return
	dir = dir / Forcelength
	# 使用摄像机方向，保证“看起来是粗线”
	var cam := get_viewport().get_camera_3d()
	if cam == null:
		return
	var view_dir := (cam.global_position - global_position).normalized()
	var right := dir.cross(view_dir).normalized() * thickness * 0.5

	var a := p0 - right
	var b := p0 + right
	var c := p1 + right
	var d := p1 - right
	# 两个三角形
	_mesh.surface_begin(Mesh.PRIMITIVE_TRIANGLE_STRIP)
	_mesh.surface_set_color(color)
	_mesh.surface_add_vertex(a)
	_mesh.surface_add_vertex(b)
	_mesh.surface_add_vertex(c)

	_mesh.surface_set_color(color)
	_mesh.surface_add_vertex(a)
	_mesh.surface_add_vertex(c)
	_mesh.surface_add_vertex(d)
	_mesh.surface_end()
"

[sub_resource type="GDScript" id="GDScript_c6ser"]
script/source = "extends Node
\"\"\"
ROV 手动控制节点（8 推进器版本）

推进器布局：
【上层垂直推进器】（负责升沉 / 横滚 / 俯仰）
- V_LF : 左前
- V_LB : 左后
- V_RF : 右前
- V_RB : 右后

【下层水平推进器】（负责前进 / 偏航 / 横移）
- H_LF : 左前
- H_LB : 左后
- H_RF : 右前
- H_RB : 右后

使用方式：
1. 在 Project Settings → Input Map 中配置 Action
2. 可在 Inspector 中修改 action_map
3. 支持键盘 / 手柄（摇杆）统一控制
\"\"\"

# =========================================================
# 推进器节点引用
# =========================================================
@onready var ThrusterList:Dictionary = {
	\"V_LF\": null, \"V_LB\": null, \"V_RF\": null, \"V_RB\": null,
	\"H_LF\": null, \"H_LB\": null, \"H_RF\": null, \"H_RB\": null
}

@export var V_LF_thruster:Node3D
@export var V_LB_thruster:Node3D
@export var V_RF_thruster:Node3D
@export var V_RB_thruster:Node3D

@export var H_LF_thruster:Node3D
@export var H_LB_thruster:Node3D
@export var H_RF_thruster:Node3D
@export var H_RB_thruster:Node3D

# 真实参与物理的刚体
@export var RovBaseNode:RigidBody3D

# =========================================================
# 推力与灵敏度参数
# =========================================================
const MAX_THRUST:float = 1000.0   # 单推进器最大推力

@export var heave_gain  :float = 400.0   # 升沉
@export var pitch_gain  :float = 300.0   # 俯仰
@export var roll_gain   :float = 300.0   # 横滚
@export var yaw_gain    :float = 300.0   # 偏航
@export var surge_gain  :float = 400.0   # 前进 / 后退
@export var sway_gain   :float = 300.0   # 横移

# =========================================================
# 输入 Action 映射表
# =========================================================
@export var action_map:Dictionary = {
	\"heave_pos\": \"heave_up\",
	\"heave_neg\": \"heave_down\",

	\"pitch_pos\": \"pitch_up\",
	\"pitch_neg\": \"pitch_down\",

	\"roll_pos\":  \"roll_right\",
	\"roll_neg\":  \"roll_left\",

	\"yaw_pos\":   \"yaw_right\",
	\"yaw_neg\":   \"yaw_left\",

	\"surge_pos\": \"move_forward\",
	\"surge_neg\": \"move_backward\",

	\"sway_pos\":  \"move_right\",
	\"sway_neg\":  \"move_left\"
}

# =========================================================
# 初始化
# =========================================================
func _ready() -> void:
	ThrusterList[\"V_LF\"] = V_LF_thruster
	ThrusterList[\"V_LB\"] = V_LB_thruster
	ThrusterList[\"V_RF\"] = V_RF_thruster
	ThrusterList[\"V_RB\"] = V_RB_thruster

	ThrusterList[\"H_LF\"] = H_LF_thruster
	ThrusterList[\"H_LB\"] = H_LB_thruster
	ThrusterList[\"H_RF\"] = H_RF_thruster
	ThrusterList[\"H_RB\"] = H_RB_thruster

# =========================================================
# 主物理循环
# =========================================================
func _physics_process(delta: float) -> void:
	manual_control(delta)

# =========================================================
# Action 轴读取工具
# =========================================================
func get_axis(pos_key:String, neg_key:String) -> float:
	\"\"\"
	将两个 Action 合成为一个逻辑轴
	返回范围：-1.0 ~ +1.0
	\"\"\"
	var pos_action:String = action_map[pos_key]
	var neg_action:String = action_map[neg_key]
	return Input.get_action_strength(pos_action) - Input.get_action_strength(neg_action)

# =========================================================
# 手动控制核心
# =========================================================
func manual_control(_delta: float) -> void:
	# ---- 读取输入轴 ----
	var heave  :float = get_axis(\"heave_pos\", \"heave_neg\")
	var pitch  :float = get_axis(\"pitch_pos\", \"pitch_neg\")
	var roll   :float = get_axis(\"roll_pos\", \"roll_neg\")
	var yaw    :float = get_axis(\"yaw_pos\", \"yaw_neg\")
	var surge  :float = get_axis(\"surge_pos\", \"surge_neg\")
	var sway   :float = get_axis(\"sway_pos\", \"sway_neg\")

	# ---- 输入 → 推力 ----
	apply_thrust_manual(
		heave * heave_gain,
		pitch * pitch_gain,
		roll  * roll_gain,
		yaw   * yaw_gain,
		surge * surge_gain,
		sway  * sway_gain
	)

# =========================================================
# 推进器混控（Mixer）
# =========================================================
func apply_thrust_manual(
	heave:float,
	pitch:float,
	roll:float,
	yaw:float,
	surge:float,
	sway:float
) -> void:
	\"\"\"
	八推进器混控逻辑

	上层垂直推进器：
	- heave → 全部同向
	- pitch → 前后差动
	- roll  → 左右差动

	下层水平推进器：
	- surge → 前后差动
	- yaw   → 左右差动
	- sway  → 横移
	\"\"\"

	# -------- 上层垂直推进器 --------
	var V_LF:float = heave - pitch + roll
	var V_LB:float = heave + pitch + roll
	var V_RF:float = heave - pitch - roll
	var V_RB:float = heave + pitch - roll

	# -------- 下层水平推进器 --------
	var H_LF:float = surge + yaw
	var H_LB:float = surge + yaw
	var H_RF:float = surge - yaw
	var H_RB:float = surge - yaw

	# 设置推进器输出
	set_thruster_power(\"V_LF\", V_LF)
	set_thruster_power(\"V_LB\", V_LB)
	set_thruster_power(\"V_RF\", V_RF)
	set_thruster_power(\"V_RB\", V_RB)
	set_thruster_power(\"H_LF\", H_LF)
	set_thruster_power(\"H_LB\", H_LB)
	set_thruster_power(\"H_RF\", H_RF)
	set_thruster_power(\"H_RB\", H_RB)

# =========================================================
# 推进器输出
# =========================================================
func set_thruster_power(name:String, power:float) -> void:
	power = clamp(power, -MAX_THRUST, MAX_THRUST) / MAX_THRUST
	ThrusterList[name].set_commd(power)

# =========================================================
# 状态接口
# =========================================================
func get_RovState() -> Dictionary:
	return {
		\"rotation\": RovBaseNode.rotation_degrees,
		\"basis\": RovBaseNode.transform.basis.get_rotation_quaternion(),
		\"global_basis\": RovBaseNode.global_transform.basis.get_rotation_quaternion(),
		\"depth\": RovBaseNode.global_position.y,
		\"state\": \"MANUAL\",
		\"velocity\": RovBaseNode.linear_velocity
	}
"

[sub_resource type="GDScript" id="GDScript_cig8n"]
script/source = "extends Control
# 飞控相关的UI集合，显示基础的姿态和PID调节

@export_group(\"UI nods\")
@export var FCnode:Node
@export var rov_state:ROVState

@export var pitch_ctrl_node:Control
@export var roll_ctrl_node:Control
@export var yaw_ctrl_node:Control

@export var StateNode:Control

func _ready() -> void:
	# 将PID控件绑定到相应的PID控制器
	#pitch_ctrl_node.pid_controller = FCnode.pid_pitch
	#roll_ctrl_node.pid_controller = FCnode.pid_roll
	#yaw_ctrl_node.pid_controller = FCnode.pid_yaw
	
	# 将rovstate节点绑定到相应UI
	StateNode.rov_state = rov_state
"

