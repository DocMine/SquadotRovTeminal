[sub_resource type="GDScript" id="GDScript_hamj1"]
script/source = "extends Panel

# 从指定的ROVstate节点读取数据并显示
@export var rov_state:ROVState

# UI节点引用
@export var Ola_x:Label
@export var Ola_y:Label
@export var Ola_z:Label

@export var Rov_Basis_a:Label
@export var Rov_Basis_b:Label
@export var Rov_Basis_c:Label
@export var Rov_Basis_d:Label

@export var deepthLabel:Label
@export var graph:Graph2D

@export var TemperatureLabel:Label
#@export var deepthLabel:Label

@onready var deep_plot:PlotItem = graph.add_plot_item(\"DEEP\", Color.GREEN, 1.0)
@onready var Temp_plot:PlotItem = graph.add_plot_item(\"TEMP\", Color.RED, 1.0)

func _ready() -> void:
	rov_state = $\"../../../RovState\"
	pass

func _updateZitaiData():
	# 显示姿态数据
	Ola_x.text = \"pitch: %.2f\" % rov_state.imu_orientation.get_euler(EULER_ORDER_XYZ).x
	Ola_y.text = \"yaw: %.2f\" % rov_state.imu_orientation.get_euler(EULER_ORDER_XYZ).y
	Ola_z.text = \"roll: %.2f\" % rov_state.imu_orientation.get_euler(EULER_ORDER_XYZ).z
	
	Rov_Basis_a.text = \"w: %.2f\" % rov_state.imu_orientation.w
	Rov_Basis_b.text = \"x: %.2f\" % rov_state.imu_orientation.x
	Rov_Basis_c.text = \"y: %.2f\" % rov_state.imu_orientation.y
	Rov_Basis_d.text = \"z: %.2f\" % rov_state.imu_orientation.z
	
	deepthLabel.text = \"  %.2f m\" % (rov_state.depth/10.0)
	graph.x_max = Time.get_ticks_msec()/100.0
	graph.x_min = graph.x_max - 100.0
	deep_plot.add_point(Vector2(Time.get_ticks_msec()/100.0, rov_state.depth))
	
	TemperatureLabel.text = \"  %.2f ℃\" % rov_state.water_temperature
	Temp_plot.add_point(Vector2(Time.get_ticks_msec()/100.0, rov_state.water_temperature))

func _physics_process(_delta: float) -> void:
	_updateZitaiData()
"

