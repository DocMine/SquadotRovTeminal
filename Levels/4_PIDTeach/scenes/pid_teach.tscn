[sub_resource type="GDScript" id="GDScript_jj3ic"]
script/source = "extends Control

@export var ThrusterNode:Node3D

@export var Namelabel:Label
@export var Valuelabel:Label
@export var ProgressN:ProgressBar
@export var ProgressP:ProgressBar

func updateUi():
	var CurrentCam:Camera3D = get_viewport().get_camera_3d()
	if CurrentCam:
		var Cpos = CurrentCam.unproject_position($\"..\".global_position)
		global_position = Cpos - Vector2(100, 0)
		Namelabel.text = \"推进器:\" + str(ThrusterNode.name)
		Valuelabel.text = \"推力: %.4f\" % ThrusterNode.thrust
		
		if ThrusterNode.thrust > 0:
			ProgressN.value = 0
			ProgressP.value = ThrusterNode.command * 100
		else:
			ProgressN.value = abs(ThrusterNode.command * 100)
			ProgressP.value = 0

func _physics_process(_delta: float) -> void:
	updateUi()
"

