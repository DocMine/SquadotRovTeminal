[sub_resource type="GDScript" id="GDScript_lnoqx"]
script/source = "extends Node
## 水动力统一计算节点（纯逻辑组件）
## 负责：推进器力、水阻力、浮力、角阻尼

# =========================================================
# 阻力参数（与外形强相关）
# =========================================================
@export_group(\"水阻力参数\")
## 前后方向阻力系数（ROV 纵向）
@export var drag_forward: float = 4.0
## 横向阻力系数（侧移）
@export var drag_side: float = 10.0
## 垂向阻力系数（升沉）
@export var drag_up: float = 12.0
## 角速度阻尼系数（抑制摇晃的关键）
@export var angular_drag_coeff: float = 4.0


# =========================================================
# 浮力参数
# =========================================================
@export_group(\"浮力参数\")
## 机器人排水体积（m³）
@export var volume: float = 0.00
## 水密度（kg/m³），淡水≈1000，海水≈1025
@export var water_density: float = 1000.0
## 浮心相对质心的偏移（本地坐标）
## 上移可以产生“自动立正”的效果
@export var buoyancy_offset: Vector3 = Vector3(0.1, 0.05, 0)

# =========================================================
# 依赖节点
# =========================================================
@export_group(\"绑定对象\")
## 受力的刚体（必须指定）
@export var body: RigidBody3D
@onready var thrustersNode:Node3D = body.find_child(\"Thrusters\")
@onready var thrusters:Array = []

# --- 用于调试显示的力缓存 ---
var _debug_forces: Array = []
# =========================================================
# 主物理更新
# =========================================================

func _ready() -> void:
	volume = body.mass / water_density
	thrusters = thrustersNode.find_children(\"*\", \"Node3D\", true)

func _physics_process(delta: float) -> void:
	_debug_forces.clear()
	# --- 推进器也在这里应用 ---
	for t in thrusters:
		if not t.has_method(\"get_force\"):
			continue
		t.update_thruster(delta)
		var force: Vector3 = t.get_force()
		var offset: Vector3 = t.global_position - body.global_position
		body.apply_force(force, offset)
		_debug_forces.append({ 
			\"type\": \"thruster\" , # \"thruster\" / \"drag\" / \"buoyancy\"
			\"pos\": t.global_position, 
			\"force\": force })
	# --- 水阻 ---
	apply_anisotropic_drag()
	# --- 角阻尼 ---
	apply_angular_drag()
	# --- 浮力 ---
	apply_buoyancy()

# =========================================================
# 各类力的实现
# =========================================================

## 浮力（作用在浮心位置）
func apply_buoyancy() -> void:
	var buoyancy_force:Vector3 = Vector3.UP * water_density * volume * 9.81
	body.apply_force(buoyancy_force, buoyancy_offset)
	_debug_forces.append({
		\"type\": \"buoyancy\" , # \"thruster\" / \"drag\" / \"buoyancy\"
		\"pos\": body.global_position + body.global_transform.basis * buoyancy_offset,
		\"force\": buoyancy_force
	})

## 各向异性水阻（与速度平方成正比）
func apply_anisotropic_drag() -> void:
	var v: Vector3 = body.linear_velocity
	if v.length() < 0.001:
		return
	var v_local: Vector3 = body.global_transform.basis.inverse() * v
	
	var drag_local: Vector3 = Vector3(
		-v_local.x * abs(v_local.x) * drag_side,
		-v_local.y * abs(v_local.y) * drag_up,
		-v_local.z * abs(v_local.z) * drag_forward
	)
	
	var drag_world: Vector3 = body.global_transform.basis * drag_local
	body.apply_central_force(drag_world)

	_debug_forces.append({
		\"type\": \"drag\" , # \"thruster\" / \"drag\" / \"buoyancy\"
		\"pos\": body.global_position,
		\"force\": drag_world
	})

## 角速度阻尼（抑制摇摆）
func apply_angular_drag() -> void:
	var w: Vector3 = body.angular_velocity
	if w.length() < 0.001:
		return
	var torque: Vector3 = -w * w.length() * angular_drag_coeff
	body.apply_torque(torque)
	
func get_debug_forces() -> Array:
	return _debug_forces
"

[sub_resource type="GDScript" id="GDScript_pt4hb"]
script/source = "extends Node3D
## 3D 力矢量调试绘制节点（Godot 4.6）
## 使用“细长三角面”模拟粗线条

# =========================================================
# 调试参数
# =========================================================

@export_group(\"调试显示\")

## 是否显示力矢量
@export var debug_draw_forces: bool = true
## 力矢量长度缩放
@export var force_scale: float = 0.5
## 线条视觉粗细（世界单位，建议 0.01 ~ 0.05）
@export var line_thickness: float = 0.15


# =========================================================
# 颜色配置
# =========================================================

@export_group(\"颜色区分\")
## 推进器力颜色
@export var color_thruster: Color = Color.RED
## 浮力颜色
@export var color_buoyancy: Color = Color.GREEN
## 阻力颜色
@export var color_drag: Color = Color.CYAN
## 其他未知力颜色
@export var color_other: Color = Color.GRAY

# =========================================================
# 内部对象
# =========================================================

var _mesh: ImmediateMesh = ImmediateMesh.new()
var _mesh_instance: MeshInstance3D = MeshInstance3D.new()
var _material: StandardMaterial3D = StandardMaterial3D.new()

@onready var hydro: Node = get_parent()


func _ready() -> void:
	# --- 材质设置（关键） ---
	_material.vertex_color_use_as_albedo = true
	_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	_material.transparency = BaseMaterial3D.TRANSPARENCY_DISABLED

	_mesh_instance.mesh = _mesh
	_mesh_instance.material_override = _material
	_mesh_instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF

	add_child(_mesh_instance)


func _process(_delta: float) -> void:
	if not debug_draw_forces:
		_mesh.clear_surfaces()
		return

	if hydro.has_method(\"get_debug_forces\"):
		draw_forces(hydro.get_debug_forces())

# =========================================================
# 绘制主逻辑
# =========================================================

func draw_forces(forces: Array) -> void:
	_mesh.clear_surfaces()
	if forces.is_empty():
		return

	for item in forces:
		if not item.has(\"pos\") or not item.has(\"force\"):
			continue
		var world_pos: Vector3 = item.pos
		var force: Vector3 = item.force * force_scale
		if force.length() < 0.0001:
			continue
		var color: Color = get_color_by_type(item.get(\"type\", \"\"))
		
		draw_thick_line(
			to_local(world_pos),
			to_local(world_pos + force),
			line_thickness,
			color
		)


# =========================================================
# 工具函数
# =========================================================

## 根据力类型返回颜色
func get_color_by_type(t: String) -> Color:
	match t:
		\"thruster\":
			return color_thruster
		\"buoyancy\":
			return color_buoyancy
		\"drag\":
			return color_drag
		_:
			return color_other


## 画一条“有厚度的 3D 线段”
func draw_thick_line(p0: Vector3, p1: Vector3, thickness: float, color: Color) -> void:
	var dir:Vector3 = (p1 - p0)
	var Forcelength:float = dir.length()
	if Forcelength < 0.0001:
		return
	dir = dir / Forcelength
	# 使用摄像机方向，保证“看起来是粗线”
	var cam: Camera3D = get_viewport().get_camera_3d()
	if cam == null:
		return
	var view_dir: Vector3 = (cam.global_position - global_position).normalized()
	var right: Vector3 = dir.cross(view_dir).normalized() * thickness * 0.5

	var a: Vector3 = p0 - right
	var b: Vector3 = p0 + right
	var c: Vector3 = p1 + right
	var d: Vector3 = p1 - right
	# 两个三角形
	_mesh.surface_begin(Mesh.PRIMITIVE_TRIANGLE_STRIP)
	_mesh.surface_set_color(color)
	_mesh.surface_add_vertex(a)
	_mesh.surface_add_vertex(b)
	_mesh.surface_add_vertex(c)

	_mesh.surface_set_color(color)
	_mesh.surface_add_vertex(a)
	_mesh.surface_add_vertex(c)
	_mesh.surface_add_vertex(d)
	_mesh.surface_end()
"

[sub_resource type="GDScript" id="GDScript_c6ser"]
script/source = "extends Node
# 这是一个控制器模板，将使用PID得到具体的输出数据？
# PID参数（可以根据实际情况调整）
# roll：横滚     pitch:俯仰     yaw:偏航
# 20260127 在角速度环上试图添加角度环

# 当前控制结构:
#TargetEuler
   #↓
#q_target
   #↓
#q_error
   #↓
#angle_error
   #↓
#【外环 PID】→ target_omega   ← 你打印的
   #↓
#【内环 PID】
   #↓
#推进器

@onready var PusherList:Dictionary = {
	\"L_F\": null, 
	\"L_B\": null, 
	\"R_F\": null,
	\"R_B\": null
}

@export var LFthruster:Node3D
@export var LBthruster:Node3D
@export var RFthruster:Node3D
@export var RBthruster:Node3D
@export var RovBaseNode:RigidBody3D

# =========================
# 外环：姿态 PID（角度 → 角速度）
# =========================
var pid_att_pitch: PIDController = PIDController.new(0.0, 0.0, 0.0)
var pid_att_roll: PIDController = PIDController.new(0.0, 0.0, 0.0)
var pid_att_yaw: PIDController = PIDController.new(0.0, 0.0, 0.0)

# =========================
# 内环：角速度 PID（角速度 → 推力）
# =========================
var pid_pitch: PIDController = PIDController.new(0.0, 0.0, 0.0)
var pid_roll: PIDController = PIDController.new(0.0, 0.0, 0.0)
var pid_yaw: PIDController = PIDController.new(0.0, 0.0, 0.0)

# 目标姿态
var TargetOrientation:Quaternion
var TargetEuler: Vector3 = Vector3(0.5, 0.0, 0.0)
# x = pitch, y = yaw, z = roll（Godot 的惯例）;# 单位：rad

const MAX_THRUST: float = 1000.0
const MAX_TARGET_OMEGA: float = 30.0   # rad/s

func _ready():
	PusherList[\"L_F\"] = LFthruster
	PusherList[\"L_B\"] = LBthruster
	PusherList[\"R_F\"] = RFthruster
	PusherList[\"R_B\"] = RBthruster

func attitude_hold(delta: float) -> void:
	# =========================
	# 当前 & 目标姿态
	# =========================
	var q_current: Quaternion = RovBaseNode.global_transform.basis.get_rotation_quaternion()
	# 【新增】欧拉角 → Quaternion（目标姿态）
	var q_target: Quaternion = Quaternion.from_euler(TargetEuler)
	var q_error: Quaternion = q_target * q_current.inverse()
	q_error = q_error.normalized()
	
	var angle_error: Vector3 = Vector3.ZERO
	var w:float = clamp(q_error.w, -1.0, 1.0)

	if w > 0.999:  
		# 小角度近似
		angle_error = Vector3(q_error.x, q_error.y, q_error.z) * 2.0
	else:
		# Axis–Angle（你原来的）
		var angle: float = 2.0 * acos(w)
		var s: float = sqrt(1.0 - w * w)
		var axis: Vector3 = Vector3(q_error.x, q_error.y, q_error.z) / s
		angle_error = axis * angle
	
	# =========================
	# 外环：角度 → 目标角速度
	# =========================
	# 此时 PID 的语义就是：“我有一个角度误差，希望它变成 0，PID 输出的是 我应该转多快”
	var target_omega: Vector3 = Vector3(
		pid_att_pitch.calculate(angle_error.x, 0.0, delta),
		pid_att_yaw.calculate(angle_error.y, 0.0, delta),
		pid_att_roll.calculate(angle_error.z, 0.0, delta)
	)
	target_omega = target_omega.clamp(
		Vector3(-MAX_TARGET_OMEGA, -MAX_TARGET_OMEGA, -MAX_TARGET_OMEGA),
		Vector3( MAX_TARGET_OMEGA,  MAX_TARGET_OMEGA,  MAX_TARGET_OMEGA)
	)
	
	
	# =========================
	# 内环：角速度 → 推力
	# =========================
	var omega_world: Vector3 = RovBaseNode.angular_velocity
	var omega_local: Vector3 = RovBaseNode.global_transform.basis.inverse() * omega_world
	
	var roll_out: float = pid_roll.calculate(target_omega.z, omega_local.z, delta)
	var pitch_out: float = pid_pitch.calculate(target_omega.x, omega_local.x, delta)
	var yaw_out: float = pid_yaw.calculate(target_omega.y, omega_local.y, delta)
	
	apply_thrust(roll_out, pitch_out, yaw_out)

func apply_thrust(roll:float, pitch:float, yaw:float):
	var L_F:float =  roll - pitch - yaw
	var L_B:float =  roll + pitch + yaw
	var R_F:float = -roll - pitch + yaw
	var R_B:float = -roll + pitch - yaw
	
	set_thruster_power(\"L_F\", L_F)
	set_thruster_power(\"L_B\", L_B)
	set_thruster_power(\"R_F\", R_F)
	set_thruster_power(\"R_B\", R_B)

func set_thruster_power(_name:String, power:float):
	power = clamp(power, -MAX_THRUST, MAX_THRUST) / MAX_THRUST
	PusherList[_name].set_commd(power)

func _physics_process(delta: float) -> void:
	attitude_hold(delta)
	#apply_thrust(500,500,0)

func get_RovState():
	# 这个方法直接获取ROV所有的状态信息
	var data:Dictionary = {
		\"degree\": RovBaseNode.rotation_degrees,
		\"basis\":RovBaseNode.transform.basis.get_rotation_quaternion(),
		\"global_basis\": RovBaseNode.global_transform.basis.get_rotation_quaternion(),
		\"deepth\": RovBaseNode.global_position.y,
		\"Current_state\": \"PID\",
		\"Velocity\": RovBaseNode.linear_velocity
	}
	return	data
"

[sub_resource type="GDScript" id="GDScript_cig8n"]
script/source = "extends Control
# 飞控相关的UI集合，显示基础的姿态和PID调节

@export_group(\"UI nods\")
@export var FCnode:Node
@export var rov_state:LegacyROVState

# 内环：角速度 PID（角速度 → 推力）
@export var pitch_ctrl_node:Control
@export var roll_ctrl_node:Control
@export var yaw_ctrl_node:Control

# 外环：姿态 PID（角度 → 角速度）
@export var pitch_att_ctrl_node:Control
@export var roll_att_ctrl_node:Control
@export var yaw_att_ctrl_node:Control

@export var StateNode:Control

func _ready() -> void:
	# 将PID控件绑定到相应的PID控制器
	pitch_ctrl_node.pid_controller = FCnode.pid_pitch
	roll_ctrl_node.pid_controller = FCnode.pid_roll
	yaw_ctrl_node.pid_controller = FCnode.pid_yaw
	
	pitch_att_ctrl_node.pid_controller = FCnode.pid_att_pitch
	roll_att_ctrl_node.pid_controller = FCnode.pid_att_roll
	yaw_att_ctrl_node.pid_controller = FCnode.pid_att_yaw
	
	# 将rovstate节点绑定到相应UI
	StateNode.rov_state = rov_state
"

