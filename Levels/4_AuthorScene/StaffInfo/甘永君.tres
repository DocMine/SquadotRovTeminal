script = ExtResource("2_bdwmu")
Img = ExtResource("1_r14de")
StaffName = "甘永君"
Info = "北京信息科技大学机电工程学院硕士研究生[p]获国际竞赛奖项1项、国家级竞赛奖项10余项、省部级竞赛奖项8项，多次获得校级及以上学业奖学金。[p]发表核心期刊学术论文2篇。[p]作为智能巡检技术攻关团队负责人，联合国家电网开展产学研合作，参与研发无人机自主避障算法、航迹规划优化策略及影像采集校准技术，成功将目标误拍率降至8.7%，巡检效率提升42%。经实践验证，该技术体系已规模化应用于华东、华南等区域超高压输电网络智能巡检，年均可降低运维成本逾千万元，形成具有自主知识产权的行业解决方案。[p]在校期间参与水下机器人、足球机器人、家庭助老机器人等多个机器人的研发过程，在机器人机械结构设计、协同控制系统开发及人机交互系统方面具备丰富的工程经验。[p]作为核心骨干参与中华社会救助基金会及北京读懂中国社会发展基金会承接的国家级课题项目，在项目规划与执行层面发挥主导作用。[p][p]专注海洋科学教育的贯通式培养课程体系建设，致力于将海洋保护理念与跨学科实践融入K12及高等教育体系，主导海洋STEM课程开发，联动科研机构开发实地研学项目，累计影响超500名学生。[p]"
metadata/_custom_type_script = "uid://cfmyp441t56x6"
