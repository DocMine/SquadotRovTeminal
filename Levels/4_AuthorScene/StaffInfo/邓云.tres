StaffName = "邓云"
Info = "毕业于北京信息科技大学机电工程学院，北京方点科技有限公司创始人[p]在水下机器人领域科技竞赛中获得十余项国家级奖项，作为核心成员深度参与多个水下航行器相关科研项目，在技术研发和工程落地中发挥关键作用，具备近10年水下航行器开发经验。[p]项目经历：[p]有缆可控水下机器人（ROV）、无缆自主水下机器人（AUV）的机械结构设计、水密关键部件设计、控制系统设计[p]小型多模态控制水下航行器整体系统方案论证、验证、设计与研发[p]水下运动体姿态控制系统的动力系统与控制系统设计[p]水下航行器关键部件的耐压测试方法与装置的设计与实现[p]工程、项目经验丰富，擅长面向巡检、勘测等特定水下环境及应用场景提出针对性强、可行性高的解决方案，致力于将科研成果、技术积累向应用领域转化，解决客户痛点和行业难题。[p]"
metadata/_custom_type_script = "uid://cfmyp441t56x6"
