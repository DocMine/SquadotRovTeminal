; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[ambientcg]

extract_path="res://AmbientCG/Extracted"
material_file_directory="res://AmbientCG/Materials"
environment_file_directory="res://AmbientCG/Environments"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="SquadotRovHub"
run/main_scene="res://Levels/1_WelcomeScene/WelcomScene.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="res://icon.svg"

[autoload]

UICore="*res://modules/ui_modules/0_Core_Autoload/UICore.gd"

[compression]

formats/gzip/compression_level=9

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/always_on_top=true
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdserial/plugin.cfg", "res://addons/graph_2d/plugin.cfg", "res://addons/tau-plot/plugin.cfg")

[input]

